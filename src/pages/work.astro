---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { links, projects } from '../data/site';
---

<Base title="Work — maxscopp">
  <div class="container page">
    <PageHead eyebrow="Selected work" title="Things I’ve designed" accent="and built.">
      A selection of products, tools and ideas — from open source tools to product experiences,
      always with a focus on real-world use and a clean, thoughtful design.
    </PageHead>

    <ul class="list">
      {
        projects.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a class="item" href={p.href}>
              <span class="icon-tile">
                <Icon name={p.icon} size={20} />
              </span>
              <span class="body">
                <h2>{p.title}</h2>
                <p>{p.description}</p>
                <span class="tags">
                  {p.tags.map((t) => (
                    <span class="pill">{t}</span>
                  ))}
                </span>
              </span>
              <Icon name="arrow" size={18} class="go" />
            </a>
          </li>
        ))
      }
    </ul>

    <a class="link more" href={links.github}>View everything on GitHub <Icon name="arrow" size={16} /></a>
  </div>
</Base>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 820px;
  }
  .list li + li {
    border-top: 1px solid var(--line);
  }
  .item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    padding: 28px 20px;
    margin-inline: -20px;
    border-radius: 24px;
    transition: background 0.2s var(--ease);
  }
  .item:hover {
    background: var(--hover);
  }
  h2 {
    font-size: 19px;
    letter-spacing: -0.015em;
  }
  .body p {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 15px;
    max-width: 56ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .item :global(.go) {
    margin-top: 4px;
    color: var(--ink-3);
    transition:
      transform 0.2s var(--ease),
      color 0.2s;
  }
  .item:hover :global(.go) {
    transform: translateX(3px);
    color: var(--violet);
  }
  .more {
    margin-top: 40px;
  }
  @media (max-width: 520px) {
    .item {
      grid-template-columns: auto 1fr;
      gap: 16px;
    }
    .item :global(.go) {
      display: none;
    }
  }
</style>
