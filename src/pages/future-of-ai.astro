---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';

// Single place to adjust the name of the workflow model used throughout the essay.
const CAO = { short: 'CAO', long: 'Continuous Agent Orchestration' };

const shift = [
  { aspect: 'Unit of work', before: 'A keystroke, a function, a suggestion', after: 'An outcome: a feature, a fix, a migration' },
  { aspect: 'Human role', before: 'Operator — drives every step', after: 'Director and first user — sets intent, approves the experience' },
  { aspect: 'AI role', before: 'Assistant — autocomplete and chat', after: 'Agents that plan, build and fix in parallel' },
  { aspect: 'Quality bar', before: 'Upheld by reviewer attention', after: 'Enforced by CI/CD on every change — pass or fail' },
  { aspect: 'Review', before: 'Line by line, by a person', after: 'Gates check the code; humans check the product' },
  { aspect: 'Bottleneck', before: 'How fast a person can type and read', after: 'How clearly intent and “done” are defined' },
];

const lanes = [
  {
    tag: 'Human',
    title: 'Direction & usage approval',
    lead: 'Decides what is worth building and whether it’s actually good to use.',
    items: [
      'Frames the problem, sets intent and acceptance criteria',
      'Uses the product like a real user would',
      'Hunts edge cases, empty states, errors and odd inputs',
      'Judges interaction, copy, accessibility and feel',
      'Owns the call to ship — and the consequences',
    ],
  },
  {
    tag: 'Agents',
    title: 'Execution & iteration',
    lead: 'Turns intent into working changes, fast and in parallel.',
    items: [
      'Plans, implements and refactors',
      'Writes and extends tests alongside the code',
      'Fixes whatever the gates reject, then tries again',
      'Explores variants so the human can compare real options',
      'Documents decisions where the next agent (or person) can read them',
    ],
  },
  {
    tag: 'Gates',
    title: 'CI/CD — the static minimum bar',
    lead: 'Deterministic, black-or-white approval on every single change.',
    items: [
      'Linting, formatting and type checks',
      'Unit, integration and end-to-end tests',
      'Static analysis and security: CodeQL, Sonar, dependency scans',
      'Builds, bundle budgets, performance and accessibility checks',
      'Same answer every time — not negotiable, not persuadable',
    ],
  },
];

const flow = [
  { who: 'Human', step: 'Intent' },
  { who: 'Agents', step: 'Build' },
  { who: 'Gates', step: 'Pass / fail', loop: true },
  { who: 'CI/CD', step: 'Preview ready' },
  { who: 'Human', step: 'Use & approve' },
  { who: 'All', step: 'Ship & learn' },
];

const corners = [
  'Skipping the tests “just this once” because the agent said it works',
  'Disabling a lint rule or suppressing a warning instead of fixing the cause',
  'Merging without ever clicking through the feature yourself',
  'Accepting generated code nobody on the team could explain',
  'Letting architecture drift because each change looked fine on its own',
  'Shipping the happy path and calling the edge cases “later”',
];

const frictions = [
  {
    title: 'Human gates sized for human output',
    text: 'An agent can produce a working change in minutes, and automated checks can verify it in minutes more. It then waits days for a ticket refinement, a review slot, a change-advisory board and a release train — all designed around the pace of people. The speedup disappears into the queue.',
  },
  {
    title: 'Context locked in heads and meetings',
    text: 'Agents are only as good as the context they get. When requirements live in hallway conversations, tribal knowledge and slide decks, the AI guesses — and humans spend the saved time correcting it.',
  },
  {
    title: 'Tools and permissions built for people',
    text: 'Access is granted per human, environments are hand-provisioned, and nothing is safe to run unattended. Agents end up in a sandbox so tight they can’t do real work, or nowhere at all.',
  },
  {
    title: 'Metrics that measure the old process',
    text: 'Story points, tickets closed and lines of code were proxies for human effort. Measured with the old yardsticks, AI either looks miraculous or useless — rarely what actually changed for users.',
  },
  {
    title: 'AI as a feature, not a rethink',
    text: 'Rolling out a chat assistant to every team is easy to announce and easy to measure in licences. It improves individual tasks by a few percent while the system around them stays exactly as slow.',
  },
];

const stages = [
  { stage: 'On save / agent edit', runs: 'Formatter', finds: 'Fixes it silently', cost: 'Nothing' },
  { stage: 'Pre-commit (lefthook)', runs: 'Formatting, import and key order, safe lint fixes — staged files only', finds: 'Fixes and re-stages; never blocks on style', cost: 'Milliseconds' },
  { stage: 'Pre-push', runs: 'Type checks, affected tests', finds: 'Stops the push, locally', cost: 'Seconds' },
  { stage: 'CI', runs: 'Everything again, plus full and end-to-end tests, CodeQL, Sonar, builds', finds: 'Blocks the merge — the binding bar', cost: 'Minutes, runners' },
  { stage: 'Merge queue', runs: 'Update from the base branch, re-run the gates', finds: 'Keeps pull requests current', cost: 'Automatic' },
];

const hookConfig = `# lefthook.yml — fix what doesn't change behaviour, before it's committed
pre-commit:
  commands:
    fix:
      glob: "*.{js,ts,tsx,json}"
      run: npx biome check --write --no-errors-on-unmatched {staged_files}
      stage_fixed: true # re-stage what was fixed

pre-push:
  commands:
    types:
      run: npx tsc --noEmit`;

// Minimal YAML highlighting: keys and comments.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const hookHtml = hookConfig
  .split('\n')
  .map((line) => {
    const hash = line.indexOf('#');
    const code = hash === -1 ? line : line.slice(0, hash);
    const note = hash === -1 ? '' : `<span class="c">${esc(line.slice(hash))}</span>`;
    const m = code.match(/^(\s*)([\w-]+:)(.*)$/);
    return (m ? `${m[1]}<span class="k">${esc(m[2])}</span>${esc(m[3])}` : esc(code)) + note;
  })
  .join('\n');

const preview = [
  'A link for every change — or an installable build for apps, desktop and CLIs',
  'Its own data: migrations applied, realistic seed data, test accounts ready',
  'Secrets and integrations already wired in, so nobody passes tokens around',
  'The same gates and configuration as production, just disposable',
  'Torn down automatically when the change merges or closes',
  'A notification when it’s ready — not a dashboard you have to watch',
];

const redesign = [
  'Define intent and acceptance criteria up front — clear enough that an agent can tell when it is done.',
  'Invest in the gates before the agents: strict linting, types, tests, CodeQL/Sonar and preview builds on every change.',
  'Let the tools fix what they can before anything is committed — formatting, whitespace, import and key order — so CI never fails on style and nobody reviews it.',
  'Write context down where agents can read it: conventions, decisions, architecture, product principles.',
  'Give agents real, scoped environments — safe to run unattended, easy to throw away.',
  'Give every change a preview — a link or an installable build, with data and secrets wired in — and a ping when it’s ready, so human review moves from the diff to the product.',
  'Keep teams small and ownership end to end, so the loop from idea to shipped isn’t split across handoffs.',
];
---

<Base
  title="The loop is moving — maxscopp"
  description="How AI in software development is shifting from human-in-the-loop assistance to orchestrated agent workflows — why static quality gates — configured right — matter more than ever, where humans belong, and why bolting AI onto enterprise processes rarely delivers."
>
  <article class="container page">
    <PageHead eyebrow="Essay · Future of AI in development" title="The loop is moving." accent="Are you moving with it?">
      Most teams use AI as a faster pair of hands. The bigger shift is structural: people step out
      of every keystroke and into direction and judgment, agents take over execution, and automated
      gates hold the line on quality. Getting those three roles right — and not confusing them — is
      the whole game.
    </PageHead>

    <div class="prose">
      <section data-reveal>
        <h2><span class="num mono">01</span>Where we are: human-in-the-loop</h2>
        <p>
          Today’s default is AI as assistant. It completes the line, drafts the function, answers
          the question in the side panel. A person drives every step and approves every change. The
          gains are real, but they are capped by the thing that hasn’t changed: one human, reading
          and deciding at human speed, in the middle of every loop.
        </p>
        <p>
          That model made sense while models were unreliable. It is increasingly the limiting factor
          now that they can plan, execute and check their own work.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">02</span>Where it’s going: {CAO.short}</h2>
        <p>
          In <strong>{CAO.long}</strong> ({CAO.short}) workflows, the human moves from{' '}
          <em>in</em> the loop to <em>above</em> it. You define the intent, the constraints and what
          “good” looks like. Agents break the work down, run in parallel and come back with results —
          not suggestions. Automated gates decide whether a change is even allowed to exist. You
          decide whether it is worth shipping.
        </p>
      </section>
    </div>

    <div class="table-wrap" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">Human-in-the-loop</th>
            <th scope="col">{CAO.short}</th>
          </tr>
        </thead>
        <tbody>
          {
            shift.map((row) => (
              <tr>
                <th scope="row">{row.aspect}</th>
                <td>{row.before}</td>
                <td>{row.after}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="prose">
      <section data-reveal>
        <h2><span class="num mono">03</span>Three roles, clearly separated</h2>
        <p>
          The mistake is treating “AI” as one blob that replaces everything. In practice there are
          three distinct parties, and each is good at something the others are not. Blur them and you
          get either a human bottleneck or an unsupervised slop machine.
        </p>
      </section>
    </div>

    <ol class="flow" aria-label="The loop, step by step" data-reveal>
      {
        flow.map((f) => (
          <li class:list={[f.loop && 'loop']}>
            <span class="who mono">{f.who}</span>
            <span class="step">{f.step}</span>
            {f.loop && <span class="back mono">fail → back to agents</span>}
          </li>
        ))
      }
    </ol>

    <div class="lanes">
      {
        lanes.map((l, i) => (
          <section class="lane" data-reveal style={`--i:${i}`}>
            <span class="tag mono">{l.tag}</span>
            <h3>{l.title}</h3>
            <p class="lead">{l.lead}</p>
            <ul>
              {l.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="prose">
      <section data-reveal>
        <h2><span class="num mono">04</span>The gates still matter — more than ever</h2>
        <p>
          A model can spot many of the same patterns as CodeQL, Sonar, a linter or a test suite. That
          doesn’t make those tools obsolete. It makes them more valuable. They are deterministic: the
          same input gets the same verdict, every time, in seconds, for almost no cost. They don’t get
          tired, don’t get talked out of a finding, and don’t have a good or bad day.
        </p>
        <p>
          That is exactly what you want from a minimum bar. CI/CD becomes a continuous,
          black-or-white approval on every change: it builds, the types hold, the tests pass, nothing
          known-vulnerable slipped in, or it doesn’t merge. Agents are great at <em>clearing</em> that
          bar — feed them the failures and they fix them. They are a poor substitute for
          <em> being</em> the bar.
        </p>
        <p>
          And a guaranteed floor is what frees people up. When you trust that nothing below the line
          ships, your attention goes where it should: the product. You can go into the details,
          iterate more, and iterate faster — without re-checking the basics every time.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">05</span>Where the human belongs: usage approval</h2>
        <p>
          With gates guarding the code and agents producing it, line-by-line PR review becomes much
          less of a focus. Spot checks still matter; reading every diff doesn’t scale and mostly
          duplicates what the tools already verify. The human’s approval moves up a level — from
          “is this code acceptable?” to “is this product right?”
        </p>
        <p>
          That means actually using it. Click through the flow on a real device. Try the empty
          state, the error state, the slow network, the absurd input, the second user, the keyboard
          only. Ask how someone who has never seen it would read that label. Notice what feels off
          even when every check is green. Automation can tell you the product works as specified;
          only a person can tell you it works for people.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">06</span>Every corner cut is a move into slop</h2>
        <p>
          With agents, corners can be cut at every angle — and each one looks harmless in isolation.
          It’s faster to skip a step, the output looks plausible, and nothing breaks today.
        </p>
      </section>
    </div>

    <ul class="corners" data-reveal>
      {corners.map((c) => <li>{c}</li>)}
    </ul>

    <div class="prose">
      <section data-reveal>
        <blockquote>
          Corners can be cut at every angle. But every corner cut is a move into slop — and slop
          compounds faster than you can generate it.
        </blockquote>
      </section>

      <section data-reveal>
        <h2><span class="num mono">07</span>A cautionary tale: more, faster, messier</h2>
        <p>
          For the first time, most teams are no longer blocked by output. Code, pull requests and
          features can be produced almost on demand. The natural reaction is to lean in: more
          features, even faster, then even more. Velocity charts look incredible.
        </p>
        <p>
          And then the product stops making sense. Features overlap, flows contradict each other,
          nobody remembers why something exists, and every new change is built on a layer nobody
          fully understands. The team didn’t slow down — it just stopped noticing the mess it was
          shipping.
        </p>
        <p>
          The lesson is old, and still invaluable: test, and keep up. Know what you have before you
          add more. The static tools help here too — not as a verdict on individual changes, but as a
          rough compass. Coverage, complexity, duplication and hotspots tell you where the product
          really stands as something you’d ship, and whether it’s still maintainable: a codebase
          developers can read, understand and get into the weeds of when they need to. Because
          eventually, someone always needs to.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">08</span>A better tale: the right configuration, right for you</h2>
        <p>
          Picture two teams with the same agents, the same models and — on paper — the same tools:
          a formatter, a linter, type checks, tests, CodeQL, Sonar. Six months in, one of them is
          flying and the other is drowning in noise. The difference isn’t the tools. It’s how they
          are configured, where they run, and how they fit into the rest of the environment.
        </p>
        <p>
          The first team bolted the tools on. Formatting is only checked in CI, so every push is a
          gamble: an agent opens a pull request, waits eight minutes, fails on a trailing comma,
          reads the log, fixes it, pushes, and waits again. Two branches format the same file
          differently and collide on whitespace. Import and key order drift with whoever touched a
          file last, so every update to a pull request conflicts — and keeping pull requests current
          quietly becomes someone’s job. Review threads fill up with style nits. And when a rule gets
          in the way, the fastest fix, for a person or an agent, is to switch it off. It’s every habit
          we developers had before AI, just faster and more expensive: CI minutes, tokens and
          attention spent on things that don’t change what the product does.
        </p>
        <p>
          The second team made a handful of decisions once, and wrote them down as configuration.
          Formatting is canonical and automatic, so two people — or two agents — writing the same
          change produce the same bytes. Imports and keys are sorted by the tools, so parallel
          branches don’t fight over order. Whitespace and line endings are settled by
          <code>.editorconfig</code> and <code>.gitattributes</code>. Lint rules that can fix
          themselves do; the few that remain exist to catch bugs, not to police taste. A merge queue
          keeps pull requests up to date with the base branch and re-runs the gates, so nobody
          babysits a rebase — and with canonical formatting, those updates almost never conflict.
        </p>
      </section>
    </div>

    <div class="table-wrap stages" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col">Where</th>
            <th scope="col">What runs</th>
            <th scope="col">When it finds something</th>
            <th scope="col">Cost</th>
          </tr>
        </thead>
        <tbody>
          {
            stages.map((row) => (
              <tr>
                <th scope="row">{row.stage}</th>
                <td data-label="Runs">{row.runs}</td>
                <td data-label="Finds something">{row.finds}</td>
                <td class="cost" data-label="Cost">{row.cost}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="prose">
      <section data-reveal>
        <p>
          The cheap, obvious fixes happen first, and locally: everything that doesn’t change what the
          code does, or changes it negligibly at worst. A git hook manager like lefthook turns that
          into a single file:
        </p>
        <pre class="code" aria-label="Example lefthook.yml"><code set:html={hookHtml}></code></pre>
        <p>
          Biome here — Prettier, ESLint, Ruff or gofmt work the same way. Install the hooks from the
          project’s setup script, so agent sandboxes run them too, not just laptops.
        </p>
        <p>
          The costs follow the same order. A pre-commit fix costs milliseconds and no tokens. A CI
          round-trip to fix the same trailing comma costs minutes of runner time plus a full agent
          turn to read the log and try again — multiplied by every pull request, every agent, every
          day.
        </p>
        <p>
          Here is the subtle part. CI still runs every check; it stays the binding, black-or-white
          bar, and if a hook is ever skipped, the bar still holds. But the checks about form rather
          than function can no longer fail — by the time a commit exists, they have already been
          applied. The minimum bar is secured before it is ever tested, and it creates no friction:
          not for the people, and not for the agents.
        </p>
      </section>

      <section data-reveal>
        <blockquote>
          Agents write code and features — not formatting. Tools format, sort and flag. People judge
          the product.
        </blockquote>
        <p>
          There is no universal preset to copy. The right configuration is the one that fits your
          stack, your repository, your CI budget and your team — decided once, versioned with the
          code, identical on every laptop, in every agent sandbox and in CI, and fast enough that
          nobody is ever tempted to bypass it. Get that right, and everyone does what they are best
          at: the tools do what they were built for, agents spend their iterations on behaviour, and
          people spend theirs on the product.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">09</span>The last mile: one click from “done” to “try it”</h2>
        <p>
          Go back to that corner: merging without ever clicking through the feature yourself. It’s
          rarely laziness. Usually, trying a change is simply harder than it should be — and that’s a
          CI/CD problem, not a discipline problem.
        </p>
        <p>
          Agents can write a feature in minutes, and well-configured gates can prove it meets the
          minimum bar minutes later. Then it reaches a person, and everything stops. To actually see
          it, someone has to check out the branch, install dependencies, dig up the right tokens, run
          the migrations, seed some data and hope their local setup matches everyone else’s. Local AI
          tools and skills can take some of that grind away, but it’s still a context switch, still
          minutes to hours, and still a reason to skip it.
        </p>
        <p>
          That’s where the speed quietly leaks out. There is no value in automating the writing if
          validating the result is the slow part. Great quality gates tell you a change is sound; they
          can’t tell you whether it’s right — from your team’s perspective, for your users. If that
          check is expensive, it gets skipped, and the corner cut becomes the process.
        </p>
      </section>

      <section data-reveal>
        <blockquote>
          Writing a feature in minutes doesn’t make you fast if trying it takes an afternoon.
        </blockquote>
        <p>
          So make trying it the cheapest step of all. Every change gets its own environment, built by
          the pipeline:
        </p>
        <ul class="ready">
          {preview.map((item) => <li>{item}</li>)}
        </ul>

        <figure class="notify">
          <div class="toast">
            <span class="agent" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="14" height="14">
                <path
                  fill="currentColor"
                  d="M16 2c.9 7.6 6.4 13.1 14 14-7.6.9-13.1 6.4-14 14-.9-7.6-6.4-13.1-14-14 7.6-.9 13.1-6.4 14-14Z"
                ></path>
              </svg>
            </span>
            <div>
              <strong class="toast-title">Hey, I’m done — your preview is ready</strong>
              <span class="toast-meta mono">checkout-redesign · gates passed · migrations applied</span>
              <span class="toast-actions" aria-hidden="true">
                <span class="mini mini--solid">Open preview</span>
                <span class="mini">Download build</span>
              </span>
            </div>
            <span class="toast-time mono">now</span>
          </div>
          <figcaption>What “done” should look like: a ping, a link, a decision.</figcaption>
        </figure>

        <p>
          Then the loop closes the way it should. The agent finishes, the gates pass, and you get a
          ping: “Hey, I’m done.” You click the link or download the build, use it like a user would,
          poke at the edge cases, and decide — ship it, or adjust the next steps and focus points and
          send the agents back in. Minutes, not an afternoon. That’s what moving fast with confidence
          actually means: not just fast output, but fast, cheap and honest validation.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">10</span>Why forcing AI into enterprise workflows gets clunky</h2>
        <p>
          Most large organisations are adopting AI the same way: take the existing process — tickets,
          handoffs, approvals, sprint ceremonies — and add an assistant to each step. It feels safe
          and it demos well. But the process itself was designed around human bottlenecks, and a
          system only moves as fast as its slowest gate.
        </p>
      </section>
    </div>

    <ul class="frictions">
      {
        frictions.map((f, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="prose">
      <section data-reveal>
        <blockquote>
          Speeding up individual steps inside a process built for humans mostly makes the queues
          longer. The work gets faster; the outcome doesn’t.
        </blockquote>
        <p>
          My expectation: most companies that approach AI this way will struggle to show a
          meaningful improvement. They’ll see pockets of productivity, a lot of licences, and a
          delivery speed that looks suspiciously like last year’s. Not because the models aren’t
          good enough — but because the organisation was never redesigned to use them.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">11</span>What works instead</h2>
        <p>
          The teams that get step changes don’t add AI to their workflow — they rebuild the workflow
          so that people, agents and gates each do what they are best at.
        </p>
        <ol class="checklist">
          {redesign.map((r) => <li>{r}</li>)}
        </ol>
        <p>
          Start small and end to end: one product, one team, one value stream redesigned properly
          beats AI sprinkled across a hundred unchanged processes. The more work agents take on, the
          more the human part — taste, judgment, empathy for the people using the thing, and
          accountability when it ships — becomes the job. That is exactly why I design and build this
          way.
        </p>
      </section>

      <footer class="end" data-reveal>
        <p>Thinking about how this applies to your product or team?</p>
        <a class="btn btn--solid" href="/contact">Let’s talk <Icon name="arrow" size={16} /></a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .prose {
    max-width: 680px;
  }
  .prose section + section {
    margin-top: 56px;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .num {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--violet);
  }
  .prose p {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .prose strong {
    color: var(--ink);
    font-weight: 500;
  }

  .table-wrap {
    margin: 48px 0 72px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 16px 22px;
