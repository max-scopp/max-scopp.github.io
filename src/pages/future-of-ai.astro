---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';

// Single place to adjust the name of the workflow model used throughout the essay.
const CAO = { short: 'CAO', long: 'Continuous Agent Orchestration' };

const shift = [
  { aspect: 'Unit of work', before: 'A keystroke, a function, a suggestion', after: 'An outcome: a feature, a fix, a migration' },
  { aspect: 'Human role', before: 'Operator — drives every step', after: 'Director — sets intent, constraints and the quality bar' },
  { aspect: 'AI role', before: 'Assistant — autocomplete and chat', after: 'Agents that plan, execute and verify in parallel' },
  { aspect: 'Review', before: 'Line by line, by a person', after: 'Automated checks first, human judgment on the result' },
  { aspect: 'Bottleneck', before: 'How fast a person can type and read', after: 'How clearly intent and “done” are defined' },
];

const frictions = [
  {
    title: 'Gates sized for human output',
    text: 'An agent can produce a working change in minutes. It then waits days for a ticket refinement, a review slot, a change-advisory board and a release train — all designed around the pace of people. The speedup disappears into the queue.',
  },
  {
    title: 'Context locked in heads and meetings',
    text: 'Agents are only as good as the context they get. When requirements live in hallway conversations, tribal knowledge and slide decks, the AI guesses — and humans spend the saved time correcting it.',
  },
  {
    title: 'Tools and permissions built for people',
    text: 'Access is granted per human, environments are hand-provisioned, and nothing is safe to run unattended. Agents end up in a sandbox so tight they can’t do real work, or nowhere at all.',
  },
  {
    title: 'Metrics that measure the old process',
    text: 'Story points, tickets closed and lines of code were proxies for human effort. Measured with the old yardsticks, AI either looks miraculous or useless — rarely what actually changed for users.',
  },
  {
    title: 'AI as a feature, not a rethink',
    text: 'Rolling out a chat assistant to every team is easy to announce and easy to measure in licences. It improves individual tasks by a few percent while the system around them stays exactly as slow.',
  },
];

const redesign = [
  'Define intent and acceptance criteria up front — clear enough that an agent can tell when it is done.',
  'Make verification automatic: tests, types, evals and previews become the first reviewer.',
  'Write context down where agents can read it: conventions, decisions, architecture, product principles.',
  'Give agents real, scoped environments — safe to run unattended, easy to throw away.',
  'Keep teams small and ownership end to end, so the loop from idea to shipped isn’t split across handoffs.',
  'Spend human time where it matters most: framing the problem, taste, trade-offs and accountability.',
];
---

<Base
  title="The loop is moving — maxscopp"
  description="How AI in software development is shifting from human-in-the-loop assistance to orchestrated agent workflows — and why forcing AI into existing enterprise processes rarely delivers."
>
  <article class="container page">
    <PageHead eyebrow="Essay · Future of AI in development" title="The loop is moving." accent="Are you moving with it?">
      Most teams use AI as a faster pair of hands. The bigger shift is structural: the human steps
      out of every keystroke and into direction. That changes how work should be organised — and
      it’s why bolting AI onto yesterday’s workflows rarely pays off.
    </PageHead>

    <div class="prose">
      <section data-reveal>
        <h2><span class="num mono">01</span>Where we are: human-in-the-loop</h2>
        <p>
          Today’s default is AI as assistant. It completes the line, drafts the function, answers
          the question in the side panel. A person drives every step and approves every change. The
          gains are real, but they are capped by the thing that hasn’t changed: one human, reading
          and deciding at human speed, in the middle of every loop.
        </p>
        <p>
          That model made sense while models were unreliable. It is increasingly the limiting factor
          now that they can plan, execute and check their own work.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">02</span>Where it’s going: {CAO.short}</h2>
        <p>
          In <strong>{CAO.long}</strong> ({CAO.short}) workflows, the human moves from{' '}
          <em>in</em> the loop to <em>above</em> it. You define the intent, the constraints and what
          “good” looks like. Agents break the work down, run in parallel, test and verify, and come
          back with results — not suggestions. You review outcomes, steer, and decide.
        </p>
        <p>
          Human judgment doesn’t disappear. It gets concentrated where it has the most leverage:
          choosing the right problem, setting the bar, and owning the decision to ship.
        </p>
      </section>
    </div>

    <div class="table-wrap" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">Human-in-the-loop</th>
            <th scope="col">{CAO.short}</th>
          </tr>
        </thead>
        <tbody>
          {
            shift.map((row) => (
              <tr>
                <th scope="row">{row.aspect}</th>
                <td>{row.before}</td>
                <td>{row.after}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="prose">
      <section data-reveal>
        <h2><span class="num mono">03</span>Why forcing AI into enterprise workflows gets clunky</h2>
        <p>
          Most large organisations are adopting AI the same way: take the existing process — tickets,
          handoffs, approvals, sprint ceremonies — and add an assistant to each step. It feels safe
          and it demos well. But the process itself was designed around human bottlenecks, and a
          system only moves as fast as its slowest gate.
        </p>
      </section>
    </div>

    <ul class="frictions">
      {
        frictions.map((f, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="prose">
      <section data-reveal>
        <blockquote>
          Speeding up individual steps inside a process built for humans mostly makes the queues
          longer. The work gets faster; the outcome doesn’t.
        </blockquote>
        <p>
          My expectation: most companies that approach AI this way will struggle to show a
          meaningful improvement. They’ll see pockets of productivity, a lot of licences, and a
          delivery speed that looks suspiciously like last year’s. Not because the models aren’t
          good enough — but because the organisation was never redesigned to use them.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">04</span>What works instead</h2>
        <p>
          The teams that get step changes don’t add AI to their workflow — they rebuild the workflow
          around what agents are good at, and put people where people are irreplaceable.
        </p>
        <ol class="checklist">
          {redesign.map((r) => <li>{r}</li>)}
        </ol>
        <p>
          Start small and end to end: one product, one team, one value stream redesigned properly
          beats AI sprinkled across a hundred unchanged processes.
        </p>
      </section>

      <section data-reveal>
        <h2><span class="num mono">05</span>What stays human</h2>
        <p>
          Knowing which problem is worth solving. Taste. Trade-offs between speed, quality and risk.
          Empathy for the people using the thing. And accountability when it ships. The more work
          agents take on, the more these become the job — which is exactly why I design and build
          this way.
        </p>
      </section>

      <footer class="end" data-reveal>
        <p>Thinking about how this applies to your product or team?</p>
        <a class="btn btn--solid" href="/contact">Let’s talk <Icon name="arrow" size={16} /></a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .prose {
    max-width: 680px;
  }
  .prose section + section {
    margin-top: 56px;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .num {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--violet);
  }
  .prose p {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .prose strong {
    color: var(--ink);
    font-weight: 500;
  }

  .table-wrap {
    margin: 48px 0 72px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  thead th:last-child {
    color: var(--violet);
  }
  tbody th {
    font-weight: 500;
    white-space: nowrap;
  }
  td {
    color: var(--ink-2);
  }

  .frictions {
    max-width: 820px;
    margin: 32px 0 56px;
    padding: 0;
    list-style: none;
  }
  .frictions li {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 8px 32px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .frictions li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .frictions h3 {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .frictions p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .frictions li {
      grid-template-columns: 1fr;
    }
  }

  blockquote {
    margin: 0;
    padding-left: 22px;
    border-left: 2px solid var(--violet);
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }

  .checklist {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .checklist li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
    color: var(--ink-2);
  }
  .checklist li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 12px;
    padding-top: 4px;
    color: var(--violet);
  }

  .end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 72px;
    padding: 24px 24px 24px 28px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .end p {
    margin: 0;
    font-size: 15px;
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .end {
      border-radius: 28px;
    }
  }
</style>
