---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { links, openSourceStats } from '../data/site';
---

<Base title="Open Source — maxscopp">
  <div class="container page">
    <PageHead eyebrow="Open source" title="Open source" accent="when it makes sense.">
      I enjoy building and contributing to projects I find genuinely interesting — especially
      around developer tools, creative tools, 3D printing, smart home and AI.
    </PageHead>

    <a class="card" href={links.github} data-reveal>
      <span class="card-head">
        <Icon name="github" size={20} />
        On GitHub
        <span class="handle mono">@max-scopp</span>
      </span>
      <dl>
        {
          openSourceStats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd class="mono">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </a>
  </div>
</Base>

<style>
  .card {
    display: block;
    max-width: 440px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--line-2);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 26px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    font-weight: 500;
  }
  .handle {
    margin-left: auto;
    font-size: 11px;
    font-weight: 400;
    color: var(--ink-3);
  }
  dl {
    margin: 0;
    padding: 14px 26px 20px;
  }
  dl div {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    font-size: 14px;
  }
  dt {
    color: var(--ink-2);
  }
  dd {
    margin: 0 0 0 auto;
    font-size: 12px;
    color: var(--ink-3);
  }
</style>
