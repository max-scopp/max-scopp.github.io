---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found — maxscopp">
  <div class="container page nf">
    <pre class="texture mono" aria-hidden="true">$ open ./this-page
error: no such file or directory</pre>
    <h1>404</h1>
    <p>This page doesn’t exist (yet).</p>
    <a class="btn btn--solid" href="/">Back home <Icon name="arrow" size={16} /></a>
  </div>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  pre {
    margin: 0;
    font-size: 12px;
  }
  h1 {
    font-size: clamp(80px, 14vw, 160px);
    font-weight: 600;
  }
  p {
    color: var(--ink-2);
  }
</style>
