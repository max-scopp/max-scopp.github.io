---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found — maxscopp">
  <Header />
  <main class="container nf">
    <pre class="texture" aria-hidden="true">$ open ./this-page
error: ENOENT — no such file or directory</pre>
    <h1>404</h1>
    <p>This page doesn’t exist (yet).</p>
    <a class="btn btn--dark" href="/">Back home <Icon name="arrow" size={16} /></a>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: 120px 160px;
  }
  h1 {
    font-size: clamp(80px, 14vw, 160px);
    font-weight: 600;
  }
  p {
    color: var(--ink-2);
  }
</style>
