---
// Stacked layers for a liquid glass surface. Put as the first child of an
// element with the `lg` class; see `.lg` in global.css and src/lib/liquid-glass.ts.
---

<span class="lg__layer lg__backdrop" aria-hidden="true"></span>
<span class="lg__layer lg__refract" aria-hidden="true"></span>
<span class="lg__layer lg__tint" aria-hidden="true"></span>
<span class="lg__layer lg__shine" aria-hidden="true"></span>
