---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { links, openSourceStats } from '../data/site';
---

<section id="open-source" class="section container">
  <SectionHead index="03" label="Open source" />
  <div class="grid">
    <div class="intro" data-reveal>
      <h2>Open source<br />when it makes sense.</h2>
      <p class="lede">
        I enjoy building and contributing to projects I find genuinely interesting — especially
        around developer tools, creative tools, 3D printing, smart home and AI.
      </p>
      <a class="link" href={links.github}>View my contributions <Icon name="arrow" size={16} /></a>
    </div>

    <div class="card-wrap" data-reveal style="--i:1">
      <a class="card" href={links.github}>
        <span class="card-head">
          <Icon name="github" size={20} />
          On GitHub
          <span class="handle mono">@max-scopp</span>
        </span>
        <dl>
          {
            openSourceStats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd class="mono">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </a>
      <pre class="texture note" aria-hidden="true">/*
 good ideas
 get better
 together.
*/</pre>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  h2 {
    font-size: clamp(34px, 4vw, 44px);
  }
  .card-wrap {
    position: relative;
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }
  .card {
    flex: 1;
    max-width: 380px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.75);
    box-shadow: 0 1px 0 rgb(255 255 255) inset, 0 20px 40px -28px rgb(76 29 149 / 0.25);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 1px 0 rgb(255 255 255) inset, 0 28px 50px -28px rgb(76 29 149 / 0.35);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    font-weight: 500;
  }
  .handle {
    margin-left: auto;
    font-size: 11px;
    font-weight: 400;
    color: var(--ink-3);
  }
  dl {
    margin: 0;
    padding: 14px 22px 18px;
  }
  dl div {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 0;
    font-size: 13.5px;
  }
  dt {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink-2);
  }
  dt::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--violet);
  }
  dd {
    margin: 0 0 0 auto;
    font-size: 12px;
    color: var(--ink-3);
  }
  .note {
    margin: 12px 0 0;
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .note {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card {
      max-width: none;
    }
  }
</style>
