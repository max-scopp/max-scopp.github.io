---
import Icon from './Icon.astro';
import { links } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="container footer">
  <span class="mono small">© {year} maxscopp · designed &amp; built by a human, with AI</span>
  <ul>
    <li><a href={links.github}><Icon name="github" size={15} /> GitHub</a></li>
    <li><a href={links.linkedin}><Icon name="linkedin" size={15} /> LinkedIn</a></li>
    <li><a href={links.email}><Icon name="mail" size={15} /> Email</a></li>
  </ul>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
  }
  .small {
    font-size: 11px;
    color: var(--ink-3);
    text-wrap: balance;
  }
  ul {
    display: flex;
    gap: 24px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-2);
    transition: color 0.2s;
  }
  a:hover {
    color: var(--violet);
  }
  @media (max-width: 640px) {
    ul {
      margin-left: 0;
    }
  }
</style>
