---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
}
const { eyebrow, title, accent } = Astro.props;
---

<header class="page-head">
  <p class="eyebrow" data-reveal>{eyebrow}</p>
  <h1 data-reveal style="--i:1">
    {title}
    {accent && <><br /><span class="gradient-text">{accent}</span></>}
  </h1>
  <div class="lede" data-reveal style="--i:2"><slot /></div>
</header>

<style>
  .page-head {
    max-width: 720px;
    margin-bottom: clamp(48px, 7vw, 80px);
  }
  h1 {
    margin-top: 16px;
    font-size: clamp(40px, 6vw, 64px);
  }
  .lede {
    margin-top: 20px;
    max-width: 56ch;
    color: var(--ink-2);
    font-size: 17px;
  }
</style>
