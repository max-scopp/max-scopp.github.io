---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { links } from '../data/site';
---

<section id="contact" class="section container">
  <SectionHead index="04" label="Let’s build something" />
  <div class="grid">
    <h2 data-reveal>Have an idea?<br />Let’s make it <span class="gradient-text">real.</span></h2>
    <div class="side" data-reveal style="--i:1">
      <p>
        I’m always excited about new projects, interesting people and challenging ideas — whether
        it’s a product, an open source collaboration or just a good conversation.
      </p>
      <div class="actions">
        <a class="btn btn--dark" href={links.email}>Get in touch <Icon name="arrow" size={16} /></a>
        <a class="btn" href="#work">View my work</a>
      </div>
    </div>
    <pre class="texture note" aria-hidden="true">/*
 interesting
 people build
 interesting
 things.
*/</pre>
  </div>
</section>

<style>
  .section {
    padding-bottom: 72px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 48px;
    align-items: start;
  }
  h2 {
    font-size: clamp(36px, 4.4vw, 48px);
  }
  .side p {
    color: var(--ink-2);
    font-size: 15px;
    max-width: 48ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }
  .note {
    margin: 0;
    line-height: 1.7;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .note {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
