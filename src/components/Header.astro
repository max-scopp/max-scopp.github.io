---
import Icon from './Icon.astro';

const nav = [
  { label: 'Work', href: '#work' },
  { label: 'Process', href: '#process' },
  { label: 'Open Source', href: '#open-source' },
];
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="maxscopp — home">
      <svg class="mark" viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M16 2c.9 7.6 6.4 13.1 14 14-7.6.9-13.1 6.4-14 14-.9-7.6-6.4-13.1-14-14 7.6-.9 13.1-6.4 14-14Z"
        ></path>
      </svg>
      maxscopp
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--dark cta" href="#contact">Let’s talk <Icon name="arrow" size={16} /></a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    background: rgb(251 250 255 / 0.72);
    border-bottom: 1px solid transparent;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .mark {
    color: var(--violet);
    transition: transform 0.6s var(--ease);
  }
  .brand:hover .mark {
    transform: rotate(90deg);
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }
  nav a {
    color: var(--ink-2);
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--ink);
  }
  .cta {
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
    .cta {
      margin-left: auto;
    }
  }
</style>
