---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import CodeBlock from './CodeBlock.astro';
import { WIDE_BLOCKS, type Block, type Essay } from '../essay/types';

interface Props {
  content: Essay;
}

const { content } = Astro.props;
const languages = [
  { lang: 'en', label: 'EN', href: '/future-of-ai' },
  { lang: 'de', label: 'DE', href: '/de/future-of-ai' },
];

// Number the sections in order, and group consecutive text blocks into the
// reading column; tables and diagrams break out to the full width.
let n = 0;
const numbered = content.blocks.map((block) => ({
  block,
  num: block.type === 'h2' ? String(++n).padStart(2, '0') : '',
}));
type Item = (typeof numbered)[number];
const groups: { wide: boolean; items: Item[] }[] = [];
for (const item of numbered) {
  const wide = WIDE_BLOCKS.has(item.block.type);
  const last = groups.at(-1);
  if (!wide && last && !last.wide) last.items.push(item);
  else groups.push({ wide, items: [item] });
}
const only = <T extends Block['type']>(b: Block, t: T) => (b.type === t ? (b as Extract<Block, { type: T }>) : null);
---

<Base
  title={content.title}
  description={content.description}
  lang={content.lang}
  alternates={languages.map(({ lang, href }) => ({ lang, href }))}
>
  <article class="container page" lang={content.lang}>
    <nav class="langs" aria-label="Language">
      {
        languages.map((l) => (
          <a href={l.href} hreflang={l.lang} lang={l.lang} aria-current={l.lang === content.lang ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <PageHead eyebrow={content.eyebrow} title={content.heading} accent={content.accent}>
      {content.intro.map((html) => <p set:html={html} />)}
    </PageHead>

    {
      groups.map((group) =>
        group.wide ? (
          group.items.map(({ block }) => {
            const table = only(block, 'table');
            const flow = only(block, 'flow');
            const lanes = only(block, 'lanes');
            const frictions = only(block, 'frictions');
            const memory = only(block, 'memory');
            const gateway = only(block, 'gateway');
            return (
              <>
                {table && (
                  <div class:list={['table-wrap', table.variant !== 'shift' && table.variant]} data-reveal>
                    <table>
                      <thead>
                        <tr>
                          {table.head.map((h) => (
                            <th scope="col" set:html={h} />
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => (
                          <tr>
                            <th scope="row" set:html={row[0]} />
                            {row.slice(1).map((cell, i) => (
                              <td
                                class:list={[table.variant === 'stages' && i === row.length - 2 && 'cost']}
                                data-label={table.head[i + 1]}
                                set:html={cell}
                              />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
                {flow && (
                  <ol class="flow" aria-label={flow.label} data-reveal>
                    {flow.steps.map((s) => (
                      <li class:list={[s.back && 'loop']}>
                        <span class="who mono">{s.who}</span>
                        <span class="step" set:html={s.step} />
                        {s.back && <span class="back mono">{s.back}</span>}
                      </li>
                    ))}
                  </ol>
                )}
                {lanes && (
                  <div class="lanes">
                    {lanes.lanes.map((l, i) => (
                      <section class="lane" data-reveal style={`--i:${i}`}>
                        <span class="tag mono">{l.tag}</span>
                        <h3 set:html={l.title} />
                        <p class="lead" set:html={l.lead} />
                        <ul>
                          {l.items.map((it) => (
                            <li set:html={it} />
                          ))}
                        </ul>
                      </section>
                    ))}
                  </div>
                )}
                {frictions && (
                  <ul class="frictions">
                    {frictions.items.map((f, i) => (
                      <li data-reveal style={`--i:${i}`}>
                        <h3 set:html={f.title} />
                        <p set:html={f.text} />
                      </li>
                    ))}
                  </ul>
                )}
                {memory && (
                  <div class="memory" data-reveal>
                    <div class="memory-core">
                      <span class="memory-tag mono">{memory.tag}</span>
                      <span class="memory-items" set:html={memory.items} />
                      <span class="memory-owner mono">{memory.owner}</span>
                    </div>
                    <ul class="perspectives" aria-label={memory.label}>
                      {memory.perspectives.map((item) => (
                        <li>
                          <span class="lens mono">{item.lens}</span>
                          <h3 set:html={item.title} />
                          <p set:html={item.text} />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {gateway && (
                  <figure class="gateway" data-reveal>
                    <ul class="clients">
                      {gateway.clients.map((c) => (
                        <li>
                          <span class="who mono">{c.who}</span>
                          {c.where}
                        </li>
                      ))}
                    </ul>
                    <span class="gw-arrow" aria-hidden="true">↓</span>
                    <div class="gw">
                      <strong set:html={gateway.title} />
                      <span class="gw-sub" set:html={gateway.sub} />
                      <span class="chips">
                        {gateway.chips.map((c) => (
                          <span set:html={c} />
                        ))}
                      </span>
                    </div>
                    <span class="gw-arrow" aria-hidden="true">↓</span>
                    <span class="models mono">{gateway.models}</span>
                    <figcaption>{gateway.caption}</figcaption>
                  </figure>
                )}
              </>
            );
          })
        ) : (
          <div class="prose">
            {group.items.map(({ block, num }) => {
              const h = only(block, 'h2');
              const para = only(block, 'p');
              const q = only(block, 'quote');
              const list = only(block, 'list');
              const note = only(block, 'note');
              const code = only(block, 'code');
              const toast = only(block, 'toast');
              const cta = only(block, 'cta');
              return (
                <>
                  {h && (
                    <h2 data-reveal>
                      <span class="num mono">{num}</span>
                      <span set:html={h.html} />
                    </h2>
                  )}
                  {para && <p data-reveal set:html={para.html} />}
                  {q && <blockquote data-reveal set:html={q.html} />}
                  {list && list.variant === 'checklist' && (
                    <ol class="checklist" data-reveal>
                      {list.items.map((it) => (
                        <li set:html={it} />
                      ))}
                    </ol>
                  )}
                  {list && list.variant !== 'checklist' && (
                    <ul class={list.variant} data-reveal>
                      {list.items.map((it) => (
                        <li set:html={it} />
                      ))}
                    </ul>
                  )}
                  {note && (
                    <aside class="lead-note" aria-label={note.label} data-reveal>
                      <span class="eyebrow">{note.eyebrow}</span>
                      <p set:html={note.intro} />
                      <ul>
                        {note.items.map((it) => (
                          <li set:html={it} />
                        ))}
                      </ul>
                      <p class="lead-close" set:html={note.close} />
                    </aside>
                  )}
                  {code && (
                    <div data-reveal>
                      <CodeBlock code={code.code} lang={code.lang} title={code.title} />
                    </div>
                  )}
                  {toast && (
                    <figure class="notify" data-reveal>
                      <div class="toast">
                        <span class="agent" aria-hidden="true">
                          <svg viewBox="0 0 32 32" width="14" height="14">
                            <path
                              fill="currentColor"
                              d="M16 2c.9 7.6 6.4 13.1 14 14-7.6.9-13.1 6.4-14 14-.9-7.6-6.4-13.1-14-14 7.6-.9 13.1-6.4 14-14Z"
                            />
                          </svg>
                        </span>
                        <div>
                          <strong class="toast-title">{toast.title}</strong>
                          <span class="toast-meta mono">{toast.meta}</span>
                          <span class="toast-actions" aria-hidden="true">
                            <span class="mini mini--solid">{toast.primary}</span>
                            <span class="mini">{toast.secondary}</span>
                          </span>
                        </div>
                        <span class="toast-time mono">{toast.time}</span>
                      </div>
                      <figcaption>{toast.caption}</figcaption>
                    </figure>
                  )}
                  {cta && (
                    <footer class="end" data-reveal>
                      <p>{cta.text}</p>
                      <a class="btn btn--solid" href="/contact">
                        {cta.button} <Icon name="arrow" size={16} />
                      </a>
                    </footer>
                  )}
                </>
              );
            })}
          </div>
        ),
      )
    }
  </article>
</Base>

<style>
  .prose {
    max-width: 680px;
  }
  .prose > h2 {
    margin-top: 64px;
  }
  .prose > h2:first-child {
    margin-top: 0;
  }
  .prose > h2 + p {
    margin-top: 16px;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .num {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--violet);
  }
  .prose p {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .prose strong {
    color: var(--ink);
    font-weight: 500;
  }

  .table-wrap {
    margin: 48px 0 72px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
  }
  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 16px 22px;
    border-bottom: 1px solid var(--line);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  thead th:last-child {
    color: var(--violet);
  }
  tbody th {
    font-weight: 500;
    white-space: nowrap;
  }
  td {
    color: var(--ink-2);
  }

  .table-wrap.stages {
    margin: 36px 0 40px;
  }
  .stages table {
    min-width: 720px;
  }
  .stages thead th:last-child {
    color: var(--ink-3);
  }
  .stages .cost {
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }

  .prose p code {
    font-family: var(--mono);
    font-size: 0.86em;
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--chip);
    color: var(--ink);
  }

  .prose > blockquote {
    margin-top: 32px;
  }
  .prose blockquote + p {
    margin-top: 24px;
  }

  /* Shared memory, different perspectives */
  .memory {
    margin: 36px 0 48px;
  }
  .memory-core {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 18px 24px;
    border-radius: 24px;
    border: 1px solid var(--tint-line);
    background: var(--tint);
  }
  .memory-tag {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--violet);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .memory-items {
    flex: 1;
    min-width: 240px;
    font-size: 14px;
    color: var(--ink);
  }
  .memory-owner {
    font-size: 11px;
    color: var(--ink-3);
  }
  .perspectives {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 16px 0 0;
    list-style: none;
  }
  .perspectives li {
    position: relative;
    padding: 20px 22px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  /* thin line up to the shared memory */
  .perspectives li::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -17px;
    width: 1px;
    height: 16px;
    background: var(--tint-line);
  }
  .lens {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--violet);
  }
  .perspectives h3 {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .perspectives p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* Lint vs guardrails */
  .table-wrap.compare {
    margin: 36px 0 40px;
  }

  /* One gateway to inference */
  .gateway {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 36px 0 48px;
  }
  .clients {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .clients li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 12px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }
  .clients .who {
    font-weight: 400;
  }
  .gw-arrow {
    font-size: 14px;
    line-height: 1;
    color: var(--ink-3);
  }
  .gw {
    width: 100%;
    padding: 22px 26px;
    border-radius: 28px;
    border: 1px solid var(--tint-line);
    background: var(--tint);
    text-align: center;
  }
  .gw strong {
    display: block;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .gw-sub {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }
  .chips span {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--tint-line);
    background: var(--surface);
    font-size: 13px;
    color: var(--ink);
  }
  .models {
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .gateway figcaption {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* Note for leads, PMs and stakeholders */
  .lead-note {
    margin: 32px 0;
    padding: 26px 28px;
    border-radius: 28px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .prose .lead-note p {
    margin-top: 12px;
    font-size: 16px;
  }
  .lead-note ul {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .lead-note li {
    display: grid;
    grid-template-columns: 22px 1fr;
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .lead-note li::before {
    content: '—';
    color: var(--violet);
  }
  .prose .lead-note .lead-close {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .ready {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .ready li {
    display: grid;
    grid-template-columns: 24px 1fr;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
    color: var(--ink-2);
  }
  .ready li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .ready li::before {
    content: '✓';
    font-family: var(--mono);
    color: var(--violet);
  }

  /* Mock "I'm done" notification */
  .notify {
    margin: 36px 0 8px;
  }
  .toast {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    max-width: 480px;
    padding: 16px 18px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .agent {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--violet);
  }
  .toast-title {
    display: block;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
  }
  .toast-meta {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    color: var(--ink-3);
  }
  .toast-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .mini {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  .mini--solid {
    background: var(--btn-bg);
    border-color: var(--btn-bg);
    color: var(--btn-fg);
  }
  .toast-time {
    font-size: 11px;
    color: var(--ink-3);
  }
  .notify figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--ink-3);
  }

  /* Flow: intent → build → gates (loop) → use & approve → ship */
  .flow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 40px 0 24px;
    padding: 0;
    list-style: none;
  }
  .flow li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 20px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .flow li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -8px;
    top: 50%;
    translate: 50% -50%;
    z-index: 1;
    font-size: 12px;
    color: var(--ink-3);
  }
  .flow li:not(:last-child) {
    margin-right: 12px;
  }
  .who {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .step {
    font-size: 15px;
    font-weight: 500;
  }
  .flow .loop {
    border-color: var(--tint-line);
    background: var(--tint);
  }
  .flow .loop .who,
  .back {
    color: var(--violet);
  }
  .back {
    font-size: 10px;
  }

  .lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 72px;
  }
  .lane {
    padding: 26px 26px 22px;
    border-radius: 28px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--violet);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .lane h3 {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .lead {
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .lane ul {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .lane li {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .corners {
    max-width: 680px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .corners li {
    display: grid;
    grid-template-columns: 24px 1fr;
    padding: 11px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
    color: var(--ink-2);
  }
  .corners li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .corners li::before {
    content: '×';
    font-family: var(--mono);
    color: var(--violet);
  }

  .frictions {
    max-width: 820px;
    margin: 32px 0 56px;
    padding: 0;
    list-style: none;
  }
  .frictions li {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 8px 32px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .frictions li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .frictions h3 {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .frictions p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  blockquote {
    margin: 0;
    padding-left: 22px;
    border-left: 2px solid var(--violet);
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }

  .checklist {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .checklist li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 8px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
